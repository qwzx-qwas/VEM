{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "$ref": "#/$defs/__schema0"
    },
    "revision": {
      "$ref": "#/$defs/__schema1"
    },
    "summary": {
      "$ref": "#/$defs/__schema4"
    },
    "evidence": {
      "$ref": "#/$defs/__schema7"
    },
    "confirmation": {
      "$ref": "#/$defs/__schema20"
    },
    "error": {
      "$ref": "#/$defs/__schema35"
    }
  },
  "required": [
    "protocolVersion",
    "revision",
    "summary",
    "evidence"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "enum": [
        "2025-03-26",
        "2025-06-18",
        "2025-11-25"
      ]
    },
    "__schema1": {
      "type": "object",
      "properties": {
        "projectInstanceId": {
          "$ref": "#/$defs/__schema2"
        },
        "coordinatorSequence": {
          "$ref": "#/$defs/__schema3"
        },
        "buildRevision": {
          "$ref": "#/$defs/__schema2"
        },
        "sourceRegistryRevision": {
          "$ref": "#/$defs/__schema2"
        },
        "documentId": {
          "$ref": "#/$defs/__schema2"
        },
        "documentGeneration": {
          "$ref": "#/$defs/__schema2"
        }
      },
      "required": [
        "projectInstanceId",
        "coordinatorSequence",
        "buildRevision",
        "sourceRegistryRevision",
        "documentId",
        "documentGeneration"
      ],
      "additionalProperties": false
    },
    "__schema2": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "__schema3": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "__schema4": {
      "type": "object",
      "properties": {
        "origin": {
          "type": "string",
          "maxLength": 256,
          "pattern": "^https?:\\/\\/(?:\\[[0-9A-Fa-f:.]+\\]|[A-Za-z0-9.-]+)(?::[0-9]{1,5})?$"
        },
        "redactedPath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^\\/[^?#]*$"
        },
        "targetSummary": {
          "$ref": "#/$defs/__schema5"
        },
        "evidenceSummary": {
          "maxItems": 8,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema5"
          }
        },
        "limitations": {
          "$ref": "#/$defs/__schema6"
        }
      },
      "required": [
        "origin",
        "redactedPath",
        "targetSummary",
        "evidenceSummary",
        "limitations"
      ],
      "additionalProperties": false
    },
    "__schema5": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "__schema6": {
      "maxItems": 16,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema5"
      }
    },
    "__schema7": {
      "type": "object",
      "properties": {
        "nodes": {
          "$ref": "#/$defs/__schema8"
        },
        "edges": {
          "$ref": "#/$defs/__schema10"
        },
        "confidenceBand": {
          "$ref": "#/$defs/__schema19"
        },
        "conflicts": {
          "$ref": "#/$defs/__schema6"
        },
        "limitations": {
          "$ref": "#/$defs/__schema6"
        }
      },
      "required": [
        "nodes",
        "edges",
        "confidenceBand",
        "conflicts",
        "limitations"
      ],
      "additionalProperties": false
    },
    "__schema8": {
      "minItems": 1,
      "maxItems": 32,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema9"
      }
    },
    "__schema9": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema2"
        },
        "kind": {
          "type": "string",
          "enum": [
            "runtime-target",
            "source-anchor",
            "registry-membership",
            "source-text",
            "candidate"
          ]
        },
        "summary": {
          "$ref": "#/$defs/__schema5"
        }
      },
      "required": [
        "id",
        "kind",
        "summary"
      ],
      "additionalProperties": false
    },
    "__schema10": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema11"
      }
    },
    "__schema11": {
      "type": "object",
      "properties": {
        "from": {
          "$ref": "#/$defs/__schema2"
        },
        "to": {
          "$ref": "#/$defs/__schema2"
        },
        "kind": {
          "$ref": "#/$defs/__schema12"
        },
        "observedBy": {
          "$ref": "#/$defs/__schema13"
        },
        "observedAt": {
          "$ref": "#/$defs/__schema14"
        },
        "documentId": {
          "$ref": "#/$defs/__schema15"
        },
        "revision": {
          "$ref": "#/$defs/__schema16"
        },
        "integrity": {
          "$ref": "#/$defs/__schema17"
        },
        "freshness": {
          "$ref": "#/$defs/__schema18"
        },
        "corroboration": {
          "$ref": "#/$defs/__schema6"
        },
        "conflicts": {
          "$ref": "#/$defs/__schema6"
        },
        "limitations": {
          "$ref": "#/$defs/__schema6"
        }
      },
      "required": [
        "from",
        "to",
        "kind",
        "observedBy",
        "observedAt",
        "integrity",
        "freshness",
        "corroboration",
        "conflicts",
        "limitations"
      ],
      "additionalProperties": false
    },
    "__schema12": {
      "type": "string",
      "enum": [
        "page-claim",
        "dom-observation",
        "registry-membership",
        "source-corroboration",
        "candidate-link"
      ]
    },
    "__schema13": {
      "type": "string",
      "enum": [
        "page-runtime",
        "content-script",
        "service-worker",
        "coordinator",
        "source-registry",
        "codex"
      ]
    },
    "__schema14": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "__schema15": {
      "$ref": "#/$defs/__schema2"
    },
    "__schema16": {
      "$ref": "#/$defs/__schema2"
    },
    "__schema17": {
      "type": "string",
      "enum": [
        "claimed",
        "directly-observed",
        "registry-matched"
      ]
    },
    "__schema18": {
      "type": "string",
      "enum": [
        "current",
        "stale",
        "unknown"
      ]
    },
    "__schema19": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low",
        "unresolved"
      ]
    },
    "__schema20": {
      "type": "object",
      "properties": {
        "confirmationId": {
          "$ref": "#/$defs/__schema21"
        },
        "protocolVersion": {
          "$ref": "#/$defs/__schema22"
        },
        "hashNamespace": {
          "$ref": "#/$defs/__schema23"
        },
        "projectInstanceId": {
          "$ref": "#/$defs/__schema2"
        },
        "mcpClientSessionId": {
          "$ref": "#/$defs/__schema2"
        },
        "mcpConnectionEpoch": {
          "$ref": "#/$defs/__schema2"
        },
        "claimId": {
          "$ref": "#/$defs/__schema2"
        },
        "selectionId": {
          "$ref": "#/$defs/__schema2"
        },
        "selectionSnapshotHash": {
          "$ref": "#/$defs/__schema24"
        },
        "documentId": {
          "$ref": "#/$defs/__schema2"
        },
        "documentGeneration": {
          "$ref": "#/$defs/__schema2"
        },
        "sourceBinding": {
          "$ref": "#/$defs/__schema25"
        },
        "allowedActions": {
          "$ref": "#/$defs/__schema26"
        },
        "allowedVerificationSpecHash": {
          "$ref": "#/$defs/__schema28"
        },
        "promptBindingHash": {
          "$ref": "#/$defs/__schema24"
        },
        "integrity": {
          "$ref": "#/$defs/__schema29"
        },
        "reportedBy": {
          "$ref": "#/$defs/__schema30"
        },
        "issuedAt": {
          "$ref": "#/$defs/__schema31"
        },
        "expiresAt": {
          "$ref": "#/$defs/__schema32"
        },
        "maxConsumptions": {
          "$ref": "#/$defs/__schema33"
        },
        "state": {
          "$ref": "#/$defs/__schema34"
        }
      },
      "required": [
        "confirmationId",
        "protocolVersion",
        "hashNamespace",
        "projectInstanceId",
        "mcpClientSessionId",
        "mcpConnectionEpoch",
        "claimId",
        "selectionId",
        "selectionSnapshotHash",
        "documentId",
        "documentGeneration",
        "sourceBinding",
        "allowedActions",
        "promptBindingHash",
        "integrity",
        "reportedBy",
        "issuedAt",
        "expiresAt",
        "maxConsumptions",
        "state"
      ],
      "additionalProperties": false
    },
    "__schema21": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{22,128}$"
    },
    "__schema22": {
      "type": "string",
      "enum": [
        "2025-03-26",
        "2025-06-18",
        "2025-11-25"
      ]
    },
    "__schema23": {
      "type": "string",
      "const": "vem-confirmation-v1-sha256"
    },
    "__schema24": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "__schema25": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "resolutionKind": {
              "type": "string",
              "const": "direct"
            },
            "sourceAnchorId": {
              "$ref": "#/$defs/__schema2"
            },
            "sourceRegistryRevision": {
              "$ref": "#/$defs/__schema2"
            },
            "normalizedRelativeFileIdentity": {
              "$ref": "#/$defs/__schema2"
            },
            "directEvidenceHash": {
              "$ref": "#/$defs/__schema24"
            }
          },
          "required": [
            "resolutionKind",
            "sourceAnchorId",
            "sourceRegistryRevision",
            "normalizedRelativeFileIdentity",
            "directEvidenceHash"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "resolutionKind": {
              "type": "string",
              "const": "degraded-candidate"
            },
            "sourceAnchorId": {
              "$ref": "#/$defs/__schema2"
            },
            "sourceRegistryRevision": {
              "$ref": "#/$defs/__schema2"
            },
            "normalizedRelativeFileIdentity": {
              "$ref": "#/$defs/__schema2"
            },
            "candidateSetHash": {
              "$ref": "#/$defs/__schema24"
            },
            "chosenCandidateRank": {
              "type": "integer",
              "minimum": 0,
              "maximum": 31
            }
          },
          "required": [
            "resolutionKind",
            "sourceRegistryRevision",
            "normalizedRelativeFileIdentity",
            "candidateSetHash",
            "chosenCandidateRank"
          ],
          "additionalProperties": false
        }
      ]
    },
    "__schema26": {
      "minItems": 1,
      "maxItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema27"
      }
    },
    "__schema27": {
      "type": "string",
      "const": "prepare-source-edit"
    },
    "__schema28": {
      "$ref": "#/$defs/__schema24"
    },
    "__schema29": {
      "type": "string",
      "enum": [
        "codex-reported-user-confirmation",
        "extension-ui-confirmed"
      ]
    },
    "__schema30": {
      "type": "string",
      "enum": [
        "codex",
        "extension-service-worker"
      ]
    },
    "__schema31": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "__schema32": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "__schema33": {
      "type": "number",
      "const": 1
    },
    "__schema34": {
      "type": "string",
      "enum": [
        "pending-display",
        "confirmed",
        "reserved",
        "consumed",
        "expired",
        "invalidated",
        "cancelled"
      ]
    },
    "__schema35": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "NO_ACTIVE_PROJECT",
            "NO_BROWSER_SESSION",
            "AMBIGUOUS_SESSION",
            "STALE_DOCUMENT",
            "STALE_REVISION",
            "SELECTION_NOT_FOUND",
            "SELECTION_CLAIM_CONFLICT",
            "SELECTION_CLAIM_EXPIRED",
            "CONFIRMATION_TARGET_CHANGED",
            "CONFIRMATION_SOURCE_CHANGED",
            "CONFIRMATION_ACTION_NOT_ALLOWED",
            "CONFIRMATION_EXPIRED",
            "CONFIRMATION_ALREADY_USED",
            "CONFIRMATION_INVALIDATED",
            "CONFIRMATION_INTEGRITY_INSUFFICIENT",
            "SELECTED_NODE_DETACHED",
            "SOURCE_UNRESOLVED",
            "CAPABILITY_UNAVAILABLE",
            "CAPTURE_EXPIRED",
            "CAPTURE_TARGET_CHANGED",
            "CAPTURE_EPOCH_INVALIDATED",
            "REQUEST_CANCELLED",
            "UPDATE_TIMEOUT",
            "VERIFICATION_NOT_PREPARED",
            "VERIFICATION_BARRIER_EXPIRED",
            "AMBIGUOUS_UPDATE_TRANSACTION",
            "UPDATE_SCOPE_UNRESOLVED",
            "QUOTA_EXCEEDED",
            "BACKPRESSURE_BUSY",
            "AUTH_FAILED",
            "PAIRING_BOOTSTRAP_INVALID",
            "ORIGIN_REJECTED"
          ]
        },
        "message": {
          "$ref": "#/$defs/__schema5"
        },
        "retryable": {
          "type": "boolean"
        },
        "suggestedAction": {
          "$ref": "#/$defs/__schema5"
        },
        "currentDocumentId": {
          "$ref": "#/$defs/__schema2"
        },
        "currentRevision": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "projectInstanceId": {
                  "$ref": "#/$defs/__schema2"
                },
                "coordinatorSequence": {
                  "$ref": "#/$defs/__schema3"
                },
                "buildRevision": {
                  "$ref": "#/$defs/__schema2"
                },
                "sourceRegistryRevision": {
                  "$ref": "#/$defs/__schema2"
                }
              },
              "required": [
                "projectInstanceId",
                "coordinatorSequence",
                "buildRevision",
                "sourceRegistryRevision"
              ],
              "additionalProperties": false
            },
            {
              "$ref": "#/$defs/__schema1"
            }
          ]
        },
        "limitations": {
          "$ref": "#/$defs/__schema6"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "additionalProperties": false
    }
  }
}
